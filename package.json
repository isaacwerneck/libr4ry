{
  "name": "library4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-editor.js",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server.js",
    "predev": "npm run build",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "markdown-it": "^15.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
