# Copie para .env e substitua pelos dados do seu PostgreSQL local.
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/BANCO
PORT=8000
# Local: mantenha loopback. Na hospedagem, use o endereço exigido pelo provedor.
HOST=127.0.0.1
# Produção: NODE_ENV=production e PUBLIC_ORIGIN=https://seu-dominio (sem barra final).
NODE_ENV=development
PUBLIC_ORIGIN=
# Opcional: IP exato do proxy que sobrescreve X-Forwarded-For com um único IP de cliente.
# IDs de contas já cadastradas, separados por vírgula. Vazio desativa moderação administrativa.
MODERATOR_USER_IDS=
TRUSTED_PROXY=
# Recuperação opcional: chave Resend e remetente/domínio verificado. Exige PUBLIC_ORIGIN.
RESEND_API_KEY=
RECOVERY_FROM=
# Opcional: habilita colaboração em tempo real pelo Hocuspocus (URL wss:// do Render).
COLLABORATION_URL=
# Segredo aleatório de 32+ bytes; use o mesmo valor no Netlify e no Render.
COLLABORATION_SECRET=
